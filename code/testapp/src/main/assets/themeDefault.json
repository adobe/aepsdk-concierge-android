{
  "metadata": {
    "brandName": "Sacramento Kings",
    "version": "1.0.0",
    "language": "en-US",
    "namespace": "brand-concierge-kings"
  },
  "header": {
    "title": "Kings Concierge",
    "subtitle": "Powered by Adobe",
    "layoutType": "textOnly"
  },
  "behavior": {
    "multimodalCarousel": {
      "cardClickAction": "openLink"
    },
    "citations": {
      "showLinkIcon": true
    },
    "input": {
      "enableVoiceInput": true,
      "disableMultiline": false,
      "showAiChatIcon": null
    },
    "productCard": {
      "cardStyle": "productDetail"
    },
    "chat": {
      "messageAlignment": "left",
      "messageWidth": "100%"
    },
    "feedback": {
      "alwaysDisplay": true,
      "thumbsPlacement": "standalone"
    },
    "welcomeCard": {
      "closeButtonAlignment": "end",
      "promptFullWidth": true,
      "promptMaxLines": 3,
      "contentAlignment": "top"
    },
    "privacyNotice": {
      "title": "Privacy Notice",
      "text": "The Sacramento Kings provides the Brand Concierge AI-assisted chatbot service. Your messages will be processed by the {Sacramento Kings} and our AI chatbot service provider, {Adobe}. Please do not provide sensitive personal information (such as financial or health information) in the chatbot. If you prefer not to use our chat service, please contact our Customer Service team at 888-91-KINGS.",
      "links": [
        {
          "text": "Sacramento Kings",
          "url": "https://www.nba.com/kings/kings-privacy-policy"
        },
        {
          "text": "Adobe",
          "url": "https://www.adobe.com/privacy/policy.html"
        }
      ]
    }
  },
  "disclaimer": {
    "text": "By using this AI-assisted chatbot service, you agree to the Sacramento Kings {Terms of Use}.",
    "links": [
      {
        "text": "Terms of Use",
        "url": "https://www.nba.com/termsofuse"
      }
    ]
  },
  "text": {
    "welcome.heading": "Welcome to Kings Concierge",
    "welcome.subheading": "Ask me about upcoming games, tickets, Golden 1 Center information, or food and beverage options. I'm here to help you find what you need.",
    "input.placeholder": "Ask anything",
    "input.messageInput.aria": "Message input",
    "input.send.aria": "Send message",
    "input.aiChatIcon.tooltip": "Ask AI",
    "input.mic.aria": "Voice input",
    "card.aria.select": "Select example message",
    "carousel.prev.aria": "Previous cards",
    "carousel.next.aria": "Next cards",
    "scroll.bottom.aria": "Scroll to bottom",
    "error.network": "I'm sorry, I'm having trouble connecting to our services right now.",
    "loading.message": "Generating a response...",
    "feedbackHelpfulLabel": "Was this helpful?",
    "sourcesLabel": "Sources",
    "feedback.dialog.title.positive": "Your feedback is appreciated",
    "feedback.dialog.title.negative": "Your feedback is appreciated",
    "feedback.dialog.question.positive": "What went well? Select all that apply.",
    "feedback.dialog.question.negative": "What went wrong? Select all that apply.",
    "feedback.dialog.notes": "Notes",
    "feedback.dialog.submit": "Submit",
    "feedback.dialog.cancel": "Cancel",
    "feedback.dialog.notes.placeholder": "Additional notes (optional)",
    "feedback.toast.success": "Thank you for the feedback.",
    "feedback.thumbsUp.aria": "Thumbs up",
    "feedback.thumbsDown.aria": "Thumbs down"
  },
  "arrays": {
    "welcome.examples": [
      {
        "text": "When’s the next Kings home game?",
        "image": "https://cdn.nba.com/teams/uploads/sites/1610612758/2024/05/Slamson.jpg",
        "backgroundColor": "#2D3437"
      },
      {
        "text": "Where can I get Kings gear?",
        "image": "https://cdn.shopify.com/s/files/1/0728/4598/4025/files/Label-K-Store-Sacramento-Kings_33d8dfb8-8814-40be-aa64-ceeb6135cb16.jpg?v=1702600520",
        "backgroundColor": "#2D3437"
      },
      {
        "text": "What are my parking options?",
        "image": "https://www.golden1center.com/wp-content/uploads/2023/08/g12.png",
        "backgroundColor": "#2D3437"
      },
      {
        "text": "What can I bring into the arena?",
        "image": "https://www.golden1center.com/wp-content/uploads/2026/09/InnovationAndEntertainment_Image1_Desktop.png",
        "backgroundColor": "#2D3437"
      }
    ],
    "feedback.positive.options": [
      "Helpful and relevant recommendations",
      "Clear and easy to understand",
      "Friendly and conversational tone",
      "Visually appealing presentation",
      "Other"
    ],
    "feedback.negative.options": [
      "Didn't understand my request",
      "Unhelpful or irrelevant information",
      "Too vague or lacking detail",
      "Errors or poor quality response",
      "Other"
    ]
  },
  "assets": {
    "icons": {
      "company": "white-crown"
    }
  },
